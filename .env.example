# Copy this file to .env and fill in values before running docker compose

# PostgreSQL
POSTGRES_DB=budgetting
POSTGRES_USER=budgetting_user
POSTGRES_PASSWORD=changeme

# Backend
JWT_SECRET=change_this_to_a_long_random_secret
PORT=8080

# Frontend (build-time)
API_BASE_URL=http://localhost:8080

# Google Maps — server-side key (Places API); restrict by IP in Google Cloud Console
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Google Maps — browser key (Maps JavaScript API); restrict by HTTP referrer
GOOGLE_MAPS_API_KEY=your_google_maps_js_api_key_here
